<Window x:Class="UltimateTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultimate Tweaker" Height="780" Width="1180" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151720" Padding="22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ULTIMATE" Foreground="White" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="TWEAKER" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Black" Margin="0,-3,0,28"/>
                    <TextBlock Text="PC CONTROL CENTER" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Button Content="⌂   Dashboard" HorizontalContentAlignment="Left" Background="#29243B" BorderBrush="#59418B" Margin="0,3" Click="Dashboard_Click"/>
                    <Button Content="⚡   Performance" HorizontalContentAlignment="Left" Margin="0,3" Click="Performance_Click"/>
                    <Button Content="⌁   Network" HorizontalContentAlignment="Left" Margin="0,3" Click="Network_Click"/>
                    <Button Content="♻   Cleanup" HorizontalContentAlignment="Left" Margin="0,3" Click="Cleanup_Click"/>
                    <Button Content="ⓘ   About & Safety" HorizontalContentAlignment="Left" Margin="0,3" Click="About_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="LOCAL WINDOWS UTILITY" Foreground="#777B8C" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="No accounts • No telemetry" Foreground="#777B8C" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitle" Text="A safer, simpler way to tune your Windows PC." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,22"/>

                <Border Background="#211B31" BorderBrush="#4B3675" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="WELCOME TO ULTIMATE TWEAKER" Foreground="#C9B4FF" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="Tune with confidence." Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,7,0,4"/>
                        <TextBlock Text="Choose individual actions, read what they do, and apply only what you need. This starter version focuses on transparent, reversible Windows tweaks."
                                   Foreground="#D0CDDA" TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="OPERATING SYSTEM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="OsValue" Text="Windows" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="DEVICE NAME" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="DeviceValue" Text="PC" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                        <StackPanel><TextBlock Text="APP STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Ready" Foreground="#8DE0B0" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="QUICK ACTIONS" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Gaming mode" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Enable Windows Game Mode for your user account." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button Content="Enable Game Mode" Click="GameMode_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Power plan" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Switch to the built-in High performance plan. Uses more power." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button Content="High performance" Click="Power_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Flush DNS cache" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Clear the local DNS resolver cache. This does not increase internet speed by itself." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button Content="Flush DNS" Click="FlushDns_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Temporary files" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Remove files from your current user's Windows Temp folder. In-use files are skipped." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button Content="Clean user temp" Click="CleanTemp_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#1B202B" CornerRadius="10" Padding="15" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY LOG" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBox x:Name="LogBox" Background="#11131A" Foreground="#C8CBD6" BorderBrush="#303442"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Height="115" Margin="0,10,0,0" Padding="9"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
